# Mono personal API token — get from https://api.monobank.ua and paste here.
# The token NEVER touches DB or filesystem inside the app — it lives only in this
# file and is read into the process via env at startup. Rotation = edit this file
# and run `docker compose up -d`.
MONO_TOKEN=

# Postgres password for the local-only db service. Never reused outside this
# compose stack. Generate with `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# SQLAlchemy URL — psycopg v3 driver. Compose injects credentials from the two
# vars above; you typically don't need to edit this directly.
DATABASE_URL=postgresql+psycopg://finance_bro:CHANGE_ME@db:5432/finance_bro

# INFO is production. DEBUG bypasses the structlog redaction processor — use only
# for local debugging. Never run DEBUG with a real token.
LOG_LEVEL=INFO

# Bind-mount root for the Postgres data directory. Defaults to `./data`. Set this
# to a path on your NAS / homelab disk; `./data/postgres` will be created under it.
DATA_DIR=./data
